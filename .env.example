# .env.example — committed to git as a template
# Copy to .env.local for development, or .env.production for builds (never commit those).
# In CI/CD the content of .env.production is stored as the GitHub Secret BACKEND_ENV.

# Contact form (https://www.emailjs.com). The template receives: name, email, subject, message.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
